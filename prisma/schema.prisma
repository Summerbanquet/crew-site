generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户表：账号密码登录，微信群昵称仅作资料不验证
model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique
  passwordHash   String
  wechat         String? // 微信群昵称，选填，方便剧组统计对名
   role           String       @default("ACTOR") // ACTOR 普通演员（接单）/ SHOOTER 拍摄（发布+接单）/ ADMIN 管理员
  points         Int          @default(0)
  createdAt      DateTime     @default(now())
  publishedTasks Task[]       @relation("Publisher")
  claims         TaskClaim[]
  pointLogs      PointLog[]
    redeems     RedeemLog[]
  notifications  Notification[]
}

// 任务表：发布 → 多人接取 → 发布人选中一人完成
model Task {
  id          Int         @id @default(autoincrement())
  title       String
  content     String
  points      Int // 完成后被选中的接单人可得的积分
  headcount   Int         @default(1) // 需要人数（发布时必填）
  deadline    DateTime?
  status      String      @default("OPEN") // OPEN 招募中（可多人接取）/ DONE 已完成 / CANCELLED 已取消
  createdAt   DateTime    @default(now())
  publisherId Int
  publisher   User        @relation("Publisher", fields: [publisherId], references: [id])
  claims      TaskClaim[]
}

// 接单记录：一个任务多人接取，发布人从中选中一条
model TaskClaim {
  id          Int       @id @default(autoincrement())
  taskId      Int
  task        Task      @relation(fields: [taskId], references: [id])
  claimantId  Int
  claimant    User      @relation(fields: [claimantId], references: [id])
  status      String    @default("PENDING") // PENDING 已接取待选择 / CONFIRMED 被选中完成 / REJECTED 未被选中
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
}

// 积分流水：每笔加减分都记一笔
model PointLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  delta     Int // 正数加、负数减
  reason    String
  createdAt DateTime @default(now())
}

// 商城商品
model Item {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  icon        String      @default("🎁")
  cost        Int
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  redeems     RedeemLog[]
}

// 兑换记录
model RedeemLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  pointsSpent Int
  status      String   @default("PENDING") // PENDING 待发货 / DONE 已完成
  createdAt   DateTime @default(now())
}

// 站内消息：接单待确认 / 接取成功 / 积分变化等提醒
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String // CLAIM 有人接了你的单（待确认）/ CLAIMED 接取成功 / CONFIRMED 确认完成积分到账 / REDEEM 兑换扣分
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 操作日志：前台关键操作全记录，管理员后台可查
// 弱关联（不建外键）：用户注销后日志仍保留可读
model OperationLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  username  String
  action    String // REGISTER/LOGIN/LOGOUT/PUBLISH/CLAIM/SELECT/REDEEM/ITEM_CREATE/ITEM_UPDATE/ITEM_SHIP
  detail    String
  ok        Boolean  @default(true)
  ip        String?
  createdAt DateTime @default(now())
}